generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique @db.VarChar
  password                 String    @db.VarChar
  name                     String    @db.VarChar
  isVerified               Boolean   @default(false)
  verificationToken        String?   @db.VarChar
  verificationTokenExpires DateTime? @db.Timestamp(6)
  refreshToken             String?   @db.VarChar
  createdAt                DateTime  @default(now()) @db.Timestamp(6)
  updatedAt                DateTime  @updatedAt @db.Timestamp(6)
  profile                  Profile?
}

model Profile{
  id        String   @id @default(uuid())
  bio       String?  @db.VarChar
  role     Role   @default(USER)
  address  Json?
  userId    String  
  user      User    @relation(fields: [userId], references: [id])
  @@unique([userId])

}

enum Role {
 USER
 ADMIN
 
}

// Inventory 

enum StatusInventory {
  ACTIVE
  INACTIVE
}

model InventoryCategory {
  id          String          @id @default(uuid())
  name        String          @db.VarChar
  description String?         @db.VarChar
  status      StatusInventory @default(ACTIVE)
  createdAt   DateTime        @default(now()) @db.Timestamp(6)
  updatedAt   DateTime        @updatedAt @db.Timestamp(6)
  inventories InventoryManagement[]  
  
}

enum UnitType {
  KG
  Liters 
  Bags 
  Pieces 
  Tons

}
model InventoryManagement{
  id                String          @id @default(uuid())
  name              String                @db.VarChar
  minimum_stock_level_alert  Int
  unit             UnitType 
  cost_per_unit    Float
  supplier_name    String?          @db.VarChar
  supplier_contact  String?          @db.VarChar
  status         StatusInventory @default(ACTIVE)
  notes           String?         @db.VarChar
  categoryId         String
  category           InventoryCategory @relation(fields: [categoryId], references: [id])
  createdAt          DateTime        @default(now()) @db.Timestamp(6)
  updatedAt          DateTime        @updatedAt @db.Timestamp(6)
  transactions InventoryTransaction[]
  finance Finnace[]
  
}
enum StockType {
  IN
  OUT
}
enum PurposeType {
  SALE
  PURCHASE
  RETURN
  DAMAGE
  ADJUSTMENT
  INITIATE_STOCK
}

// transactionQuantity ==> quantity added or removed in the transaction
// stock ==> current quantity after the transaction

model InventoryTransaction {
  id                 String          @id @default(uuid())
  inventoryId      String
  inventory         InventoryManagement @relation(fields: [inventoryId], references: [id])
  stockType  StockType
  purpose          PurposeType
  transactionQuantity         Int
  stock  Int
  transactionDate  DateTime        @default(now()) @db.Timestamp(6)
  notes            String?         @db.VarChar
  createdAt        DateTime        @default(now()) @db.Timestamp(6)
  updatedAt        DateTime        @updatedAt @db.Timestamp(6)
}

// Finance 
enum TransactionType {
  INCOME
  EXPENSE

}
enum paymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  MOBILE_PAYMENT
}
enum TransactionCategory {
  SALE
  PURCHASE
  RETURN
  DAMAGE
  ADJUSTMENT
  SALARY
  RENT
  UTILITIES
  MAINTENANCE
  LOGISTICS
  OTHER
}
model Finnace{
  id                String          @id @default(uuid())
  amount            Float
  transactionType   TransactionType
  transactionCategory  TransactionCategory
  notes      String?         @db.VarChar
  paymentMethod     paymentMethod@default(CASH)
  transactionId      String
  inventoryId      String?
  inventory         InventoryManagement? @relation(fields: [inventoryId], references: [id])
  transactionDate  DateTime        @default(now()) @db.Timestamp(6)
  createdAt        DateTime        @default(now()) @db.Timestamp(6)
  updatedAt        DateTime        @updatedAt @db.Timestamp(6)
}



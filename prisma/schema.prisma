generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique @db.VarChar
  password                 String    @db.VarChar
  name                     String    @db.VarChar
  isVerified               Boolean   @default(false)
  verificationToken        String?   @db.VarChar
  verificationTokenExpires DateTime? @db.Timestamp(6)
  refreshToken             String?   @db.VarChar
  createdAt                DateTime  @default(now()) @db.Timestamp(6)
  updatedAt                DateTime  @updatedAt @db.Timestamp(6)
  profile                  Profile?
}

model Profile {
  id      String  @id @default(uuid())
  bio     String? @db.VarChar
  userId  String  @unique
  address Json?
  role    Role    @default(USER)
  user    User    @relation(fields: [userId], references: [id])
}

model InventoryCategory {
  id          String                @id @default(uuid())
  name        String                @db.VarChar
  description String?               @db.VarChar
  status      StatusInventory       @default(ACTIVE)
  createdAt   DateTime              @default(now()) @db.Timestamp(6)
  updatedAt   DateTime              @updatedAt @db.Timestamp(6)
  inventories InventoryManagement[]
}

model InventoryManagement {
  id                        String                 @id @default(uuid())
  name                      String                 @db.VarChar
  minimum_stock_level_alert Int
  unit                      UnitType
  cost_per_unit             Float
  supplier_name             String?                @db.VarChar
  supplier_contact          String?                @db.VarChar
  status                    StatusInventory        @default(ACTIVE)
  notes                     String?                @db.VarChar
  categoryId                String
  createdAt                 DateTime               @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime               @updatedAt @db.Timestamp(6)
  finance                   Finnace[]
  category                  InventoryCategory      @relation(fields: [categoryId], references: [id])
  transactions              InventoryTransaction[]
}

model InventoryTransaction {
  id                  String              @id @default(uuid())
  inventoryId         String
  stockType           StockType
  transactionQuantity Int
  transactionDate     DateTime            @default(now()) @db.Timestamp(6)
  notes               String?             @db.VarChar
  createdAt           DateTime            @default(now()) @db.Timestamp(6)
  updatedAt           DateTime            @updatedAt @db.Timestamp(6)
  purpose             PurposeType
  stock               Int
  inventory           InventoryManagement @relation(fields: [inventoryId], references: [id])
}

model Finnace {
  id                  String               @id @default(uuid())
  amount              Float
  transactionType     TransactionType
  transactionCategory TransactionCategory
  notes               String?              @db.VarChar
  paymentMethod       paymentMethod        @default(CASH)
  transactionId       String
  inventoryId         String?
  transactionDate     DateTime             @default(now()) @db.Timestamp(6)
  createdAt           DateTime             @default(now()) @db.Timestamp(6)
  updatedAt           DateTime             @updatedAt @db.Timestamp(6)
  inventory           InventoryManagement? @relation(fields: [inventoryId], references: [id])
}

model ProductFromMarket {
  id          String   @id @default(uuid())
  name        String   @db.VarChar
  description String?  @db.VarChar
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)
}

model productpricefrommarket {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar
  category    String   @db.VarChar
  category_id String   @db.VarChar
  weight      String   @db.VarChar
  price       String   @db.VarChar
  source      String   @db.VarChar
  scraped_at  DateTime @db.Timestamp(6)
}

enum Role {
  USER
  ADMIN
}

enum StatusInventory {
  ACTIVE
  INACTIVE
}

enum UnitType {
  KG
  Liters
  Bags
  Pieces
  Tons
}

enum StockType {
  IN
  OUT
}

enum PurposeType {
  SALE
  PURCHASE
  RETURN
  DAMAGE
  ADJUSTMENT
  INITIATE_STOCK
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum paymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  MOBILE_PAYMENT
}

enum TransactionCategory {
  SALE
  PURCHASE
  SALARY
  RENT
  UTILITIES
  MAINTENANCE
  OTHER
  LOGISTICS
  RETURN
  DAMAGE
  ADJUSTMENT
}

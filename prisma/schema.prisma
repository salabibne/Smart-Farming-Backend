generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique @db.VarChar
  password                 String    @db.VarChar
  name                     String    @db.VarChar
  isVerified               Boolean   @default(false)
  verificationToken        String?   @db.VarChar
  verificationTokenExpires DateTime? @db.Timestamp(6)
  refreshToken             String?   @db.VarChar
  createdAt                DateTime  @default(now()) @db.Timestamp(6)
  updatedAt                DateTime  @updatedAt @db.Timestamp(6)
  profile                  Profile?
  inventories InventoryManagement[]
  inventoryTransactions InventoryTransaction[]
  finances Finnace[]
fields Field[]
}

model Profile {
  id      String  @id @default(uuid())
  bio     String? @db.VarChar
  userId  String  @unique
  address Json?
  role    Role    @default(USER)
  user    User    @relation(fields: [userId], references: [id])
}

model InventoryCategory {
  id          String                @id @default(uuid())
  name        String                @db.VarChar
  description String?               @db.VarChar
  status      StatusInventory       @default(ACTIVE)
  createdAt   DateTime              @default(now()) @db.Timestamp(6)
  updatedAt   DateTime              @updatedAt @db.Timestamp(6)
  inventories InventoryManagement[]
}

model InventoryManagement {
  id                        String                 @id @default(uuid())
  name                      String                 @db.VarChar
  minimum_stock_level_alert Int
  unit                      UnitType
  cost_per_unit             Float
  supplier_name             String?                @db.VarChar
  supplier_contact          String?                @db.VarChar
  status                    StatusInventory        @default(ACTIVE)
  notes                     String?                @db.VarChar
  categoryId                String
  createdAt                 DateTime               @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime               @updatedAt @db.Timestamp(6)
  finance                   Finnace[]
  category                  InventoryCategory      @relation(fields: [categoryId], references: [id])
  transactions              InventoryTransaction[]
  userId                  String?
  user                    User?                  @relation(fields: [userId], references: [id])
}

model InventoryTransaction {
  id                  String              @id @default(uuid())
  inventoryId         String
  stockType           StockType
  transactionQuantity Int
  transactionDate     DateTime            @default(now()) @db.Timestamp(6)
  notes               String?             @db.VarChar
  createdAt           DateTime            @default(now()) @db.Timestamp(6)
  updatedAt           DateTime            @updatedAt @db.Timestamp(6)
  purpose             PurposeType
  stock               Int
  inventory           InventoryManagement @relation(fields: [inventoryId], references: [id])
  userId           String?
  user           User?               @relation(fields: [userId], references: [id])
}

model Finnace {
  id                  String               @id @default(uuid())
  amount              Float
  transactionType     TransactionType
  transactionCategory TransactionCategory
  notes               String?              @db.VarChar
  paymentMethod       paymentMethod        @default(CASH)
  transactionId       String
  inventoryId         String?
  transactionDate     DateTime             @default(now()) @db.Timestamp(6)
  createdAt           DateTime             @default(now()) @db.Timestamp(6)
  updatedAt           DateTime             @updatedAt @db.Timestamp(6)
  inventory           InventoryManagement? @relation(fields: [inventoryId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  
}

model ProductFromMarket {
  id          String   @id @default(uuid())
  name        String   @db.VarChar
  description String?  @db.VarChar
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)
}

model productpricefrommarket {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar
  category    String   @db.VarChar
  category_id String   @db.VarChar
  weight      String   @db.VarChar
  price       String   @db.VarChar
  source      String   @db.VarChar
  scraped_at  DateTime @db.Timestamp(6)
}

model crops {
  id                   String                @id @db.Uuid
  name_english         String                @unique @db.VarChar
  name_bangla          String?               @db.VarChar
  variety              String?               @db.VarChar
  category             String?               @db.VarChar
  growth_duration_days String?               @db.VarChar
  fertilizer_planning  fertilizer_planning[]
}

model fertilizer_application_schedule {
  id                       String                   @id @db.Uuid
  fertilizer_plan_id       String?                  @db.Uuid
  stage                    String?                  @db.VarChar
  timing_days_after_sowing Int?
  method_of_application    String?
  fertilizer_planning      fertilizer_planning?     @relation(fields: [fertilizer_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fertilizer_split_ratio   fertilizer_split_ratio[]
}

model fertilizer_planning {
  id                              String                            @id @db.Uuid
  crop_id                         String?                           @db.Uuid
  calculation_basis               String?
  fertilizer_application_schedule fertilizer_application_schedule[]
  crops                           crops?                            @relation(fields: [crop_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fertilizer_requirements         fertilizer_requirements[]
}

model fertilizer_requirements {
  id                  String               @id @db.Uuid
  fertilizer_plan_id  String?              @db.Uuid
  fertilizer_name     String?              @db.VarChar
  quantity_kg         Decimal?             @db.Decimal(10, 3)
  fertilizer_planning fertilizer_planning? @relation(fields: [fertilizer_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model fertilizer_split_ratio {
  id                              String                           @id @db.Uuid
  schedule_id                     String?                          @db.Uuid
  fertilizer_name                 String?                          @db.VarChar
  split_ratio                     Decimal?                         @db.Decimal(4, 2)
  fertilizer_application_schedule fertilizer_application_schedule? @relation(fields: [schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Field{
  id        String   @id @default(uuid())
  name      String   @db.VarChar
  location  String   @db.VarChar
  size_Square_Meter  Float
  imageURL String
  N Float
  P Float
  K Float
  pH Float
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

enum Role {
  USER
  ADMIN
}

enum StatusInventory {
  ACTIVE
  INACTIVE
}

enum UnitType {
  KG
  Liters
  Bags
  Pieces
  Tons
}

enum StockType {
  IN
  OUT
}

enum PurposeType {
  SALE
  PURCHASE
  RETURN
  DAMAGE
  ADJUSTMENT
  INITIATE_STOCK
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum paymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  MOBILE_PAYMENT
}

enum TransactionCategory {
  SALE
  PURCHASE
  SALARY
  RENT
  UTILITIES
  MAINTENANCE
  OTHER
  LOGISTICS
  RETURN
  DAMAGE
  ADJUSTMENT
}
